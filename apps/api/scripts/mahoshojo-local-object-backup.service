[Unit]
Description=MahoShojo local object backup

[Service]
Type=oneshot
Environment=LOCAL_OBJECTS_DIR=/opt/mahoshojo-hono/data/objects
Environment=LOCAL_BACKUP_DIR=/opt/mahoshojo-hono/data/backups
Environment=LOCAL_BACKUP_RETENTION_DAYS=14
ExecStart=/bin/sh /opt/mahoshojo-hono/current/backup-local-objects.sh
